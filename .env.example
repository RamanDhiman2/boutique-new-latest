# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS Configuration (Contact Us form)
# Obtain these from your EmailJS Dashboard (https://dashboard.emailjs.com/)
# 1. Service ID: Email Services -> Service ID (connected Gmail service)
# 2. Template ID: Email Templates -> Template ID (Contact Us template)
# 3. Public Key: Account -> Public Key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
